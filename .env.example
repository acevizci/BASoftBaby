# Bu dosyanin kopyasini .env adiyla olustur ve degerleri doldur.
# Gercek degerler asla depoya yazilmaz; Vercel'de proje ayarlarinda durur.

# Neon Postgres baglanti adresi. Vercel'de Neon kurulumu bunu kendisi ekler.
DATABASE_URL="postgresql://kullanici:sifre@sunucu/veritabani?sslmode=require"

# Yonetim panelinin sifresi. Tanimli degilse panel tamamen kapali kalir.
YONETIM_SIFRE=""

# Urun fotograflarinin deposu. Vercel panelinde Storage > Blob olusturup
# projeye baglayinca degiskenler kendiliginden ekleniyor; ancak bir sonraki
# dagitimda (Redeploy) calisan koda geciyorlar.
#
# Iki baglama bicimi de calisiyor:
#   - Okuma-yazma jetonu: BLOB_READ_WRITE_TOKEN (on ek verildiyse
#     ON_EK_READ_WRITE_TOKEN adiyla gelir, o da taniniyor).
#   - OIDC: jeton yerine yalnizca BLOB_STORE_ID eklenir; yetki her istege
#     Vercel'in verdigi kisa omurlu OIDC jetonundan gelir, .env'e yazilmaz.
# Ikisi de yoksa yerelde .yuklenen/ klasoru kullaniliyor.
BLOB_READ_WRITE_TOKEN=""
