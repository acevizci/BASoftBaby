# Bu dosyanin kopyasini .env adiyla olustur ve degerleri doldur.
# Gercek degerler asla depoya yazilmaz; Vercel'de proje ayarlarinda durur.

# Neon Postgres baglanti adresi. Vercel'de Neon kurulumu bunu kendisi ekler.
DATABASE_URL="postgresql://kullanici:sifre@sunucu/veritabani?sslmode=require"

# Yonetim panelinin sifresi. Tanimli degilse panel tamamen kapali kalir.
YONETIM_SIFRE=""

# Urun fotograflarinin deposu. Vercel panelinde Storage > Blob olusturup
# projeye baglayinca kendiliginden eklenir; degisken ancak bir sonraki
# dagitimda (Redeploy) calisan koda geciyor. Depoyu baglarken bir on ek
# verildiyse ad ON_EK_READ_WRITE_TOKEN olur, o da taniniyor. Tanimli degilse
# yerelde .yuklenen/ klasoru kullaniliyor.
BLOB_READ_WRITE_TOKEN=""
