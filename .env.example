# Bu dosyanin kopyasini .env adiyla olustur ve degerleri doldur.
# Gercek degerler asla depoya yazilmaz; Vercel'de proje ayarlarinda durur.

# Neon Postgres baglanti adresi. Vercel'de Neon kurulumu bunu kendisi ekler.
DATABASE_URL="postgresql://kullanici:sifre@sunucu/veritabani?sslmode=require"

# Yonetim panelinin sifresi. Tanimli degilse panel tamamen kapali kalir.
YONETIM_SIFRE=""

# Urun fotograflarinin deposu. Vercel panelinde Storage > Blob olusturup
# projeye baglayinca degiskenler kendiliginden ekleniyor; ancak bir sonraki
# dagitimda (Redeploy) calisan koda geciyorlar.
#
# Iki baglama bicimi de calisiyor:
#   - Okuma-yazma jetonu: BLOB_READ_WRITE_TOKEN (on ek verildiyse
#     ON_EK_READ_WRITE_TOKEN adiyla gelir, o da taniniyor).
#   - OIDC: jeton yerine yalnizca BLOB_STORE_ID eklenir; yetki her istege
#     Vercel'in verdigi kisa omurlu OIDC jetonundan gelir, .env'e yazilmaz.
# Ikisi de yoksa yerelde .yuklenen/ klasoru kullaniliyor.
BLOB_READ_WRITE_TOKEN=""

# Sitenin kendi adresi. Sitemap, canonical adresler ve yapisal veri bunu
# kullaniyor. Tanimli degilse Vercel'in verdigi uretim adresi, o da yoksa
# http://localhost:3000 kullaniliyor. Alan adi alininca burayi tanimla.
SITE_URL="https://basoftbaby.com"

# iyzico anahtarlari. Ikisi de tanimli degilse kartla odeme musteriye hic
# sunulmuyor, havale tek basina calismaya devam ediyor. Sandbox anahtarlari
# "sandbox-" ile basliyor ve kendiliginden sandbox adresine gidiyor.
IYZICO_API_ANAHTARI=""
IYZICO_GIZLI_ANAHTAR=""
# Yalnizca adresi elle vermek gerekirse; normalde bos birakilir.
IYZICO_TABAN_ADRES=""

# Zamanli islerin (yarida kalan odemelerin temizligi) parolasi. Vercel bunu
# proje ayarlarindan kendisi ekliyor; tanimliysa uc onu ariyor.
CRON_SECRET=""

# E-posta gonderimi (Resend). Tanimli degilse e-posta gonderilmiyor, akislar
# calismaya devam ediyor: siparis aliniyor, sifre sifirlama baglantisi
# uretiliyor ama gonderilemedigi gunluge yaziliyor. Gonderen adresin alan
# adinin Resend'de dogrulanmis olmasi gerekiyor.
RESEND_ANAHTARI=""
EPOSTA_GONDEREN="BASoftBaby <siparis@basoftbaby.com>"

# Kargo toplayicisi (Geliver/Navlungo) baglaninca kullanilacak. Tanimli
# degilse panelden elle takip numarasi giriliyor, akisin geri kalani ayni.
KARGO_API_ANAHTARI=""
# Tasiyici durum bildirimi ucunun sirri. Tanimli degilse uc hic calismiyor.
KARGO_BILDIRIM_SIRRI=""

# e-Arsiv fatura saglayicisi (Parasut/Bizim Hesap) baglaninca kullanilacak.
# Tanimli degilse fatura panelden olusturulup yazdiriliyor.
FATURA_API_ANAHTARI=""
