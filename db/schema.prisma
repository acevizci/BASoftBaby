// BASoftBaby veri modeli — katalog ve sipariş bölümü.
//
// Bağlantı adresi burada durmaz; Vercel'de DATABASE_URL olarak tanımlı.
//
// Para her yerde tam sayı kuruş (bkz. docs/02-mimari.md, 01. karar).

generator client {
  provider = "prisma-client"
  output   = "../db/uretilen"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  ad        String
  aciklama  String?
  sira      Int        @default(0)
  aktif     Boolean    @default(true)
  products  Product[]
  campaigns Campaign[]
  ageGroups AgeGroup[]

  @@index([aktif, sira])
}

/// Beden: ad, boy-kilo karşılığı ve sıra. Panelden yönetiliyor.
///
/// `ProductVariant.beden` bu tabloya yabancı anahtarla bağlı değil, adı
/// metin olarak tutuyor. Sebebi sipariş geçmişi: satılmış bir bedenin adı
/// sonradan değişse bile sipariş satırındaki kopya olduğu gibi kalmalı.
/// Beden adı değiştirilirken açık varyantlar aynı işlem içinde
/// güncelleniyor, sipariş satırları güncellenmiyor.
model Size {
  id    String @id @default(cuid())
  ad    String @unique
  boy   String
  kilo  String
  sira  Int    @default(0)
  aktif Boolean @default(true)

  /// Ana sayfadaki ve süzgeçteki yaş grubu kodu; boşsa yaş süzgecinde çıkmaz
  yasKodu String?

  @@index([aktif, sira])
}

/// Vitrindeki yaş grubu: ana sayfadaki kutular ve süzgeçteki yaş etiketleri.
/// Hangi bedenin hangi gruba girdiği beden kaydında duruyor (Size.yasKodu).
///
/// Grup isteğe bağlı olarak bir kategoriye bağlanabiliyor: "Kız Çocuk" ile
/// "Erkek Çocuk" aynı bedenleri paylaşıyor, beden tek başına ikisini
/// ayıramıyor (K-80). Bağlıysa süzgeç yalnızca o kategorinin ürünlerini
/// getiriyor; kategori silinirse bağ kalkıyor, grup duruyor.
model AgeGroup {
  id         String    @id @default(cuid())
  kod        String    @unique
  ad         String
  aciklama   String
  sira       Int       @default(0)
  aktif      Boolean   @default(true)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([aktif, sira])
}

/// Katalog rengi: adi, cizim paleti ve sirasi. Panelden yonetiliyor (K-66).
/// ProductVariant.renk buraya yabanci anahtarla bagli degil, kodu metin
/// olarak tutuyor — siparis satirindaki kopya sonradan degismemeli.
model Color {
  id    String  @id @default(cuid())
  kod   String  @unique
  ad    String
  sira  Int     @default(0)
  aktif Boolean @default(true)

  /// Fotograf yokken cizilen urun gorselinin renkleri
  zemin String
  c1    String
  c2    String
  c3    String

  @@index([aktif, sira])
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  ad         String
  ozet       String
  aciklama   String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  fiyatKurus     Int
  eskiFiyatKurus Int?
  /// Alış fiyatı (maliyet, K-108), KDV hariç (K-111). Yalnızca panelde;
  /// mağazaya hiç gitmiyor: katalog ürünü alan alan eşliyor.
  alisFiyatKurus Int?

  // Bebek tekstilinde yasal zorunluluk (bkz. docs/01-kurulus-plani.md § 3)
  kumasIcerigi   String
  yikamaTalimati String
  ureticiBilgisi String?

  /// Ortalama puan ve yorum sayısı. Değerlendirmelerden hesaplanıyor, elle
  /// yazılmıyor: uydurma puan hem müşteriyi yanıltır hem e-ticaret
  /// mevzuatına aykırı (K-34). Hiç yorum yoksa boş kalıyor ve ekranda
  /// puan satırı hiç görünmüyor.
  puan        Decimal? @db.Decimal(2, 1)
  yorumSayisi Int      @default(0)

  /// Ürün sayfasındaki madde madde özellikler
  ozellikler String[]

  /// Kart üzerindeki rozet: "Çok satan", "%20", "Son 3 adet"
  rozetTon  String?
  rozetYazi String?

  /// Gerçek fotoğraflar çekilene kadar kullanılan çizim ve renk paleti.
  /// Fotoğraflar geldiğinde ProductImage devreye girip bunlar düşecek.
  gorsel String @default("zibin")
  palet  String @default("mint")

  aktif       Boolean  @default(true)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  /// Aranabilir alanların normalleştirilmiş hâli: Türkçe harfler ASCII'ye
  /// çevrilmiş, küçük harf, noktalama boşluk. Müşteri "zibin" yazınca
  /// "Zıbın" bulunsun diye (K-35). Her ürün yazmasından sonra tazeleniyor.
  aramaMetni String @default("")

  variants  ProductVariant[]
  images    ProductImage[]
  campaigns Campaign[]
  yorumlar  Review[]
  favoriler Favorite[]

  @@index([categoryId, aktif])
  @@index([aramaMetni])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  beden      String
  renk       String
  /// Stok kodu — kargo ve sayımda kullanılır
  sku        String @unique
  /// Etiketteki barkodun numarası (K-107): "B" + bu sayı. SKU'lar 30
  /// karaktere varıyor, 50 mm etikete sığınca çizgiler okunamayacak kadar
  /// inceliyordu; kısa numara çizgileri üç kat kalınlaştırıyor.
  barkodNo   Int    @unique @default(autoincrement())
  stok       Int    @default(0)
  /// Varyant bazlı fiyat farkı; boşsa ürünün fiyatı geçerli
  fiyatKurus Int?

  cartItems   CartItem[]
  orderItems  OrderItem[]
  bildirimler StockAlert[]
  hareketler  StockMovement[]
  sayimlar    StockCountLine[]

  @@unique([productId, beden, renk])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Büyük görselin adresi (yayında Vercel Blob URL'i, yerelde /yuklenen/...)
  yol      String
  /// Kartlarda kullanılan küçük kopya
  kucukYol String @default("")

  /// Büyük görselin ölçüleri: img etiketine yazılıyor, sayfa zıplamasın diye
  genislik  Int @default(0)
  yukseklik Int @default(0)
  boyutBayt Int @default(0)

  altMetin String

  /// Fotoğrafın gösterdiği renk. Boşsa her renkte gösteriliyor: kumaş
  /// yakın çekimi, etiket, ölçü kartı gibi renkten bağımsız kareler için.
  /// Müşteri "Mavi" seçince krem fotoğrafa bakıyordu (K-48).
  renk String?
  sira Int     @default(0)

  olusturuldu DateTime @default(now())

  @@index([productId, sira])
}

/// Duyuru şeridindeki tek bir mesaj. Tarihi geçen mesaj sorgudan düşer.
model Announcement {
  id          String    @id @default(cuid())
  metin       String
  link        String?
  sira        Int       @default(0)
  aktif       Boolean   @default(true)
  baslangic   DateTime?
  bitis       DateTime?
  olusturuldu DateTime  @default(now())

  @@index([aktif, sira])
}

/// Sitenin tek satırlık ayar kaydı. id her zaman "tek".
model StoreSetting {
  id               String  @id @default("tek")
  seritAcik        Boolean @default(true)
  seritHiz         String  @default("orta")
  seritRenk        String  @default("nane")
  seritDurdurHover Boolean @default(true)
  seritMobilde     Boolean @default(true)
  tohumAtildi      Boolean @default(false)

  /// Sipariş numarası sayacı. Sipariş oluşturulurken aynı işlem içinde artar.
  sonSiparisNo Int @default(0)

  kargoKurus       Int @default(4990)
  /// Bu tutarın üstünde kargo bedava. Sıfır verilirse kargo hep ücretli.
  bedavaKargoEsigi Int @default(75000)

  /// Kâr hesabının giderleri (K-112). Boşsa "girilmedi": o kalem hesaba
  /// girmiyor, ekranda eksik diye yazıyor. Sıfır "gider yok" demek.
  /// Kargo firmasına gönderi başına ödenen ortalama ücret.
  kargoGiderKurus        Int?
  /// Sipariş başına paket (kutu, poşet, etiket).
  paketGiderKurus        Int?
  /// Hediye paketinin ek maliyeti.
  hediyePaketGiderKurus  Int?
  /// Kart komisyonu, on binde (349 = %3,49), ve işlem başı sabit ücret.
  /// iyzico cevabında gerçek komisyon varsa o kullanılıyor; bunlar yedek.
  kartKomisyonOnbinde    Int?
  kartKomisyonSabitKurus Int?

  /// Havale/EFT yapacak müşteriye gösterilen banka bilgisi. Boşsa bu ödeme
  /// yöntemi müşteriye hiç sunulmaz.
  havaleBilgisi String @default("")

  /// Havale siparişine tanınan ödeme süresi (saat). Süre dolunca sipariş
  /// kendiliğinden iptal oluyor ve stok geri veriliyor (K-64). Sıfır
  /// verilirse otomatik iptal kapanıyor.
  havaleSaat    Int    @default(72)
  /// Süre dolmadan bu kadar saat önce hatırlatma e-postası. Sıfırsa
  /// hatırlatma gönderilmiyor.
  havaleHatirlatmaSaat Int @default(24)

  /// Ana sayfadaki banner kaç saniyede bir değişsin
  bannerSaniye Int @default(6)

  /// Örnek bannerlar bir kez yazıldı mı. Silinen banner yayında geri gelmesin diye.
  bannerTohumu Boolean @default(false)

  /// Satıcı künyesi. Mesafeli satışta müşteriye gösterilmesi zorunlu; alt
  /// bilgide ve yasal metinlerin altında bu alanlar basılıyor. Boş olanlar
  /// hiç gösterilmiyor, yarım künye yerine eksik satır görünmesin diye.
  unvan         String @default("")
  vergiDairesi  String @default("")
  vergiNo       String @default("")
  mersisNo      String @default("")
  /// ETBİS kayıt numarası — e-ticaret sitelerinde sitede görünmesi zorunlu.
  etbisNo       String @default("")
  sirketAdresi  String @default("")
  destekTelefon String @default("")
  destekEposta  String @default("")

  /// Faturada kullanılan KDV oranı (yüzde). Bebek tekstilinde 10; ürün
  /// grubuna göre değişirse panelden güncelleniyor.
  kdvOrani           Int    @default(10)
  /// Fatura numarası sayacı. Fatura oluşturulurken aynı işlem içinde artıyor.
  sonFaturaNo        Int    @default(0)
  /// Sevk irsaliyesi sayacı; faturadan ayrı bir seri (K-59).
  sonIrsaliyeNo      Int    @default(0)
  /// Panelde kargo alanına önceden seçili gelen taşıyıcı.
  varsayilanTasiyici String @default("yurtici")
}

/// Ziyaretçinin sepeti. Tarayıcıdaki `sepet` çerezi bu kaydın id'sini tutar;
/// çerez httpOnly olduğu için içeriği yalnızca sunucu değiştirebilir.
/// Sepette fiyat tutulmaz: fiyat her görüntülemede üründen okunur, böylece
/// panelden yapılan fiyat değişikliği sepete de yansır.
model Cart {
  id          String     @id @default(cuid())
  olusturuldu DateTime   @default(now())
  guncellendi DateTime   @updatedAt
  satirlar    CartItem[]

  /// Sepeti dolduran üye. Üyeliksiz sepetlerde boş kalır. Hatırlatma
  /// e-postası ancak bu doluysa gönderilebiliyor: adresi olmayan birine
  /// e-posta atılamaz.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Hatırlatma e-postasının gönderildiği an. Bir sepete bir kez
  /// hatırlatılıyor; ikinci e-posta ısrar olur.
  hatirlatildi DateTime?

  @@index([guncellendi])
  @@index([customerId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adet      Int            @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

/// Sipariş. Sipariş satırları ürün silinse bile bozulmasın diye ürün adını,
/// bedenini ve o günkü fiyatını kendi içinde kopya tutar.
model Order {
  id     String @id @default(cuid())
  /// Müşteriye gösterilen numara: BA-2026-0001
  numara String @unique

  /// bekliyor · hazirlaniyor · kargoda · teslim · iptal
  durum        String @default("bekliyor")
  /// havale · kart (iyzico)
  odemeYontemi String @default("havale")
  /// bekliyor · odendi · iade
  odemeDurumu  String @default("bekliyor")

  adSoyad   String
  eposta    String
  telefon   String
  adres     String
  ilce      String
  il        String
  postaKodu String
  not       String @default("")
  /// Hediye paketi istendi mi; notu paketin içine konuyor, irsaliyede
  /// yazıyor (K-98). Fiyat irsaliyede zaten yok.
  hediyePaketi Boolean @default(false)
  hediyeNotu   String  @default("")

  araToplamKurus Int
  /// Uygulanan kampanyanın indirimi. İndirimler üst üste binmez (K-02).
  indirimKurus   Int     @default(0)
  /// Müşteriye gösterilen kampanya adı; sonradan kampanya silinse de kalır.
  kampanyaAdi    String?
  kargoKurus     Int
  toplamKurus    Int

  /// Kargo firması takip numarası; 05. adımda kargo entegrasyonu dolduracak.
  kargoTakipNo String?

  /// Havale hatırlatması gönderildiği an. Bir kez gönderiliyor; ikinci
  /// e-posta ısrar olurdu (K-64).
  hatirlatildi DateTime?

  /// Teslim edildiği an. Cayma hakkının 14 günü buradan sayılıyor (K-33);
  /// `guncellendi` kullanılamaz, o her panel dokunuşunda değişiyor.
  teslimTarihi DateTime?

  /// Müşterinin ön bilgilendirme formu ile mesafeli satış sözleşmesini
  /// onayladığı an. Onay kutusu işaretlenmeden sipariş oluşmuyor; kaydı
  /// burada duruyor ki sonradan "onaylamadım" denemesin.
  sozlesmeOnayi DateTime?

  /// Sipariş üye olarak verildiyse hesabı. Üyeliksiz siparişlerde boş kalır;
  /// hesap silinse bile sipariş kaydı ayakta kalsın diye ilişki SetNull.
  /// Eski siparişler e-postası tuttuğu için kendiliğinden bağlanmaz (K-14).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  olusturuldu DateTime       @default(now())
  guncellendi DateTime       @updatedAt
  satirlar    OrderItem[]
  odemeler    Payment[]
  gonderiler  Shipment[]
  fatura      Invoice?
  irsaliye    Waybill?
  talepler    OrderRequest[]
  iadeler     Refund[]

  @@index([durum, olusturuldu])
  @@index([eposta])
  @@index([customerId, olusturuldu])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Ürün sonradan silinirse boşa düşer, sipariş kaydı ayakta kalır.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  urunAd     String
  slug       String
  beden      String
  renk       String
  adet       Int
  /// Sipariş anındaki birim fiyat. Sonradan fiyat değişse bile bu değişmez.
  fiyatKurus Int
  /// Kampanya indiriminin bu satıra düşen payı (satırın tamamı için, K-109).
  /// Yalnızca kampanyanın kapsadığı satırlara düşüyor. Boşsa eski sipariş:
  /// pay bilinmiyor, iade eski oransal hesapla yapılıyor.
  indirimKurus Int?
  /// Sipariş anındaki birim alış fiyatı, KDV hariç (K-111). Alış fiyatı
  /// sonradan değişse de bu değişmez. Boşsa maliyet bilinmiyor.
  alisFiyatKurus Int?
  /// Alış fiyatı sipariş anında değil sonradan, o günkü değerle yazıldıysa.
  alisTahmini    Boolean @default(false)

  talepSatirlari OrderRequestItem[]
  yorum          Review?

  @@index([orderId])
}

/// Kampanya ve kupon.
///
/// İndirimler ÜST ÜSTE BİNMEZ: bir sepete birden çok kampanya uyuyorsa
/// yalnızca en çok indiren uygulanır (bkz. docs/04-kararlar.md, K-02).
/// Kupon kodu olanlar müşteri kodu yazana kadar uygulanmaz; kodu boş olanlar
/// koşulları tuttuğu anda kendiliğinden devreye girer.
model Campaign {
  id String @id @default(cuid())
  ad String

  /// yuzde · tutar
  tip   String @default("yuzde")
  /// yuzde ise 20 (= %20), tutar ise kuruş
  deger Int

  /// tumu · kategori · urun
  kapsam     String    @default("tumu")
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Boşsa kampanya kendiliğinden uygulanır; doluysa müşteri bu kodu yazmalı.
  kuponKodu String? @unique

  /// Sepet ara toplamı bu tutarın altındaysa kampanya uygulanmaz.
  enAzSepetKurus Int @default(0)

  aktif     Boolean   @default(true)
  baslangic DateTime?
  bitis     DateTime?

  /// Kaç siparişte uygulandığı; panelde raporlama için.
  kullanim    Int      @default(0)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([aktif, baslangic, bitis])
  @@index([categoryId])
  @@index([productId])
}

/// Ana sayfanın üstündeki dönen banner. Birden çok kayıt varsa sırayla
/// kendiliğinden geçer; tek kayıt varsa sabit durur.
model HeroBanner {
  id      String @id @default(cuid())
  baslik  String
  altYazi String @default("")

  dugmeYazi String @default("")
  dugmeLink String @default("")

  /// Arka plan paleti ve yanında duran çizim
  palet  String @default("sari")
  gorsel String @default("amblem")

  /// Resimli banner (K-89): doluysa banner yalnızca bu resim; başlık resmin
  /// alternatif metni, düğme bağlantısı resmin bağlantısı oluyor. Boşsa
  /// yazı + çizim banner'ı.
  resimYol       String @default("")
  resimKucukYol  String @default("")
  resimGenislik  Int    @default(0)
  resimYukseklik Int    @default(0)
  /// Telefonda gösterilen ayrı resim (isteğe bağlı): geniş bir kampanya
  /// görseli telefonda okunmayacak kadar küçülüyor.
  telefonYol       String @default("")
  telefonGenislik  Int    @default(0)
  telefonYukseklik Int    @default(0)

  sira      Int       @default(0)
  aktif     Boolean   @default(true)
  baslangic DateTime?
  bitis     DateTime?

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([aktif, sira])
}

/// Müşteri hesabı.
///
/// Şifrenin kendisi hiçbir yerde durmaz; `sifreOzeti` scrypt ile üretilmiş
/// özeti tutar (bkz. server/uyelik.ts). E-posta henüz doğrulanmıyor: doğrulama
/// için e-posta servisi gerekiyor, o 04. adımda gelecek (K-14).
model Customer {
  id               String    @id @default(cuid())
  eposta           String    @unique
  adSoyad          String
  telefon          String    @default("")
  sifreOzeti       String
  /// E-postanın sahibi olduğu kanıtlandığı an. Doğrulanana kadar o adresle
  /// üyeliksiz verilmiş siparişler hesaba bağlanmıyor (K-14).
  epostaDogrulandi DateTime?
  olusturuldu      DateTime  @default(now())
  guncellendi      DateTime  @updatedAt

  /// Kampanya ve hatırlatma e-postası izni.
  ///
  /// Ticari elektronik ileti için önceden onay şart (6563 sayılı kanun).
  /// Varsayılan kapalı; kutu kayıt formunda işaretsiz geliyor. İznin ne zaman
  /// verildiği de tutuluyor, çünkü onayın ispatı gönderene ait.
  pazarlamaIzni       Boolean   @default(false)
  pazarlamaIzniTarihi DateTime?

  oturumlar  CustomerSession[]
  adresler   Address[]
  siparisler Order[]
  jetonlar   CustomerToken[]
  sepetler   Cart[]
  favoriler  Favorite[]
}

/// Tek kullanımlık e-posta jetonu: şifre sıfırlama ve e-posta doğrulama.
///
/// Oturumda olduğu gibi jetonun kendisi değil SHA-256 özeti saklanıyor:
/// veritabanını görebilen biri kimsenin şifresini sıfırlayamasın. Kullanılan
/// jeton bir daha çalışmıyor, süresi geçen de.
model CustomerToken {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// sifirlama · dogrulama
  tur         String
  biter       DateTime
  kullanildi  DateTime?
  olusturuldu DateTime  @default(now())

  @@index([customerId, tur])
  @@index([biter])
}

/// Açık oturum.
///
/// Çerezdeki jetonun kendisi değil, SHA-256 özeti saklanır: veritabanını
/// görebilen biri oturumları ele geçiremesin. Süresi geçen kayıtlar okuma
/// sırasında siliniyor.
model CustomerSession {
  id          String   @id
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  olusturuldu DateTime @default(now())
  sonGorulme  DateTime @default(now())
  biter       DateTime

  @@index([customerId])
  @@index([biter])
}

/// Adres defteri. Sipariş bu kaydı işaret etmez, içeriğini kopyalar: adres
/// sonradan değişse bile eski siparişin teslimat bilgisi olduğu gibi kalır.
model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  baslik     String  @default("Adresim")
  adSoyad    String
  telefon    String
  adres      String
  ilce       String
  il         String
  postaKodu  String  @default("")
  varsayilan Boolean @default(false)

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([customerId, varsayilan])
}

/// Yasal metin sayfası: mesafeli satış sözleşmesi, ön bilgilendirme formu,
/// KVKK aydınlatma metni, çerez politikası.
///
/// İçerik panelden düzenleniyor, koda gömülü değil: avukattan gelen metin
/// yayın beklemeden yapıştırılabilsin. `taslakMi` işaretliyken sayfanın
/// tepesinde metnin taslak olduğu yazıyor — müşteri onaylanmış sanmasın.
model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  baslik      String
  ozet        String   @default("")
  /// Düz metin. Boş satır paragrafı, "## " ile başlayan satır başlığı,
  /// "- " ile başlayan satır madde olur (bkz. ui/yasal-metin.tsx).
  icerik      String
  taslakMi    Boolean  @default(true)
  sira        Int      @default(0)
  guncellendi DateTime @updatedAt

  @@index([sira])
}

/// Kartla ödeme girişimi.
///
/// Bir siparişin birden çok girişimi olabilir: kart reddedilir, müşteri tekrar
/// dener. Her girişim ayrı satır; siparişin ödendi sayılması için birinin
/// başarılı olması yeterli.
///
/// Kart numarası, CVC ve 3D Secure şifresi hiçbir aşamada bize gelmez: müşteri
/// bunları iyzico'nun kendi ekranına girer (K-07, K-17). Burada yalnızca
/// iyzico'nun verdiği kimlikler ve tutar durur.
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  saglayici    String  @default("iyzico")
  /// Ödeme formunun jetonu. Dönüş çağrısı bunu getiriyor, kaydı bununla
  /// buluyoruz; tekil olduğu için aynı dönüş iki kez işlenmiyor (K-06).
  jeton        String  @unique
  /// iyzico ödeme kimliği — iade ve sorgulama için gerekiyor.
  saglayiciRef String?

  /// baslatildi · basarili · basarisiz
  durum      String  @default("baslatildi")
  tutarKurus Int
  /// iyzico'nun kestiği komisyon (K-112): ödeme cevabındaki komisyon oranı
  /// tutarı + işlem ücreti. Boşsa cevapta yoktu; ayardaki oranla tahmin.
  komisyonKurus Int?
  /// Karttan gerçekten çekilen tutar (K-110). Taksitte vade farkı müşteriye
  /// yansıtılıyorsa sipariş toplamından büyük; fark vade farkı.
  odenenKurus Int?
  taksit     Int     @default(1)
  /// Başarısızsa iyzico'nun verdiği sebep; müşteriye gösterilen kısa hâli.
  hata       String?
  /// Sorun çıkarsa bakılabilsin diye iyzico'nun ham cevabı (JSON).
  hamYanit   String?

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([orderId])
  @@index([durum, olusturuldu])
}

/// Para iadesi.
///
/// **İade borcu kayıtta durmalı.** Parası alınmış bir sipariş iptal ya da
/// iade edildiğinde mağazanın müşteriye borcu doğuyor. Eskiden bu hiçbir yere
/// yazılmıyordu; sipariş "ödeme bekliyor"a düşüyor ve borç kayboluyordu
/// (K-57).
///
/// Bir siparişin birden çok iadesi olabilir: üç üründen biri bugün, biri
/// haftaya iade edilebiliyor. Her biri ayrı satır, kendi tutarıyla.
///
/// Kart ödemelerinde iade iyzico'ya da gönderiliyor (`saglayiciRef`
/// dönen iade kimliği). Havalede para elle gönderiliyor, kayıt burada
/// "tamamlandı" işaretleniyor (K-58).
model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// İadeyi doğuran talep; panelden elle açılan iadede boş kalır.
  requestId String?
  request   OrderRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  tutarKurus Int
  /// havale · kart — siparişin ödeme yöntemi
  yontem     String

  /// bekliyor · tamamlandi · basarisiz
  durum String @default("bekliyor")
  /// iyzico iade kimliği ya da havale dekont açıklaması
  saglayiciRef String?
  /// Sağlayıcı reddettiyse sebebi
  hata         String?
  /// Panelde kim tamamladı
  yapanId      String?
  aciklama     String @default("")

  olusturuldu DateTime  @default(now())
  tamamlandi  DateTime?

  @@index([durum, olusturuldu])
  @@index([orderId])
}

/// Kargo gönderisi.
///
/// Taşıyıcı toplayıcısı (Geliver/Navlungo) bağlanana kadar panelden elle
/// giriliyor: mağaza sahibi anlaşmalı kargodan aldığı takip numarasını
/// yazıyor, müşteriye bildirim kendiliğinden gidiyor. Toplayıcı gelince
/// `saglayici`, `saglayiciRef` ve `etiketAdresi` dolacak, geri kalan akış
/// aynı kalacak (K-19).
model Shipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// yurtici · aras · mng · ptt · surat · diger
  tasiyici String
  takipNo  String
  /// Etikette basılan barkod. Takip numarası varsa o, yoksa sipariş numarası.
  barkod   String
  /// Kargo firmasına ödenen gerçek ücret (K-112); boşsa ayardaki ortalama.
  ucretKurus Int?

  /// Toplayıcı bağlanınca dolacak alanlar.
  saglayici    String?
  saglayiciRef String?
  etiketAdresi String?

  /// hazirlandi · verildi · yolda · teslim · iade
  durum       String   @default("hazirlandi")
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([orderId])
  @@index([takipNo])
}

/// Sevk irsaliyesi.
///
/// **Faturadan ayrı bir belge.** Fatura satışın belgesi, irsaliye malın
/// belgesi: kutunun yanında gider, malın kimden kime, ne zaman fiilen
/// sevk edildiğini gösterir. Fiyat taşımak zorunda değil — taşımıyor da:
/// kutuyu açan kargo görevlisinin ya da hediye alıcısının fiyatı görmesi
/// gerekmiyor (K-59).
///
/// Zorunlu alanlar kayıtta: kendi seri-sıra numarası, düzenleme tarih-saati
/// ve **fiili sevk tarih-saati**. Düzenleme ile sevk farklı olabiliyor:
/// akşam hazırlanıp sabah kargoya verilen paket.
model Waybill {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// BA-I-2026-0001
  numara String   @unique
  /// Belgenin düzenlendiği an
  tarih  DateTime @default(now())
  /// Malın fiilen sevk edildiği an; boşsa henüz çıkmamış
  sevk   DateTime?

  /// Taşıyıcı ve takip numarası — belgenin üstünde yazıyor
  tasiyici String @default("")
  takipNo  String @default("")

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt
}

/// e-Arşiv fatura kaydı.
///
/// Fatura sağlayıcısı (Paraşüt, Bizim Hesap) bağlanana kadar fatura burada
/// oluşturulup panelden yazdırılıyor; kesilen resmî faturanın numarası ve
/// bağlantısı sonradan buraya yazılabiliyor. Tutarlar sipariş anındaki
/// hâlinden kopyalanıyor, sonradan değişen KDV oranı eski faturayı
/// bozmuyor (K-20).
model Invoice {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// BA-F-2026-0001
  numara String   @unique
  tarih  DateTime @default(now())

  /// Yüzde olarak KDV oranı; matrah ve KDV kuruş.
  kdvOrani    Int
  matrahKurus Int
  kdvKurus    Int
  toplamKurus Int

  /// Resmî fatura dışarıda kesildiyse numarası ve belgesi.
  saglayici    String?
  saglayiciRef String?
  pdfAdresi    String?

  /// taslak · kesildi · iptal
  durum       String   @default("taslak")
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt
}

/// Onay bekleyen toplu ürün yüklemesi.
///
/// Dosya yüklenince satırlar çözülüp buraya yazılıyor, mağaza sahibi ne
/// olacağını görüp onaylıyor, sonra kataloğa işleniyor. Ara kayıt olmasının
/// sebebi onay ekranı: JavaScript kapalı tarayıcıda da çalışsın diye çözülmüş
/// satırlar iki istek arasında bir yerde durmak zorunda. Uygulanmış ve
/// uygulanmadan unutulmuş kayıtlar günlük temizlikte siliniyor.
model ProductImport {
  id          String    @id @default(cuid())
  dosyaAdi    String
  satirlar    Json
  /// Biçim hataları (satır no, sütun, mesaj). Onay ekranında gösteriliyor;
  /// hata varsa uygulama düğmesi hiç çıkmıyor.
  hatalar     Json
  satirSayisi Int
  /// Önizleme anında var olan beden-renklerin stoğu ("slug|beden|renk" →
  /// adet). Onayda stok bundan farklıysa arada satış olmuş demek; o satırın
  /// stoğu yazılmıyor (K-102).
  anlikStok   Json?
  uygulandi   DateTime?
  olusturuldu DateTime  @default(now())

  @@index([olusturuldu])
}

/// Stok hareketi (K-103): stoğun her değişimi bir satır.
///
/// "Dün 8'di, bugün 3; 5'i nereye gitti" sorusunun cevabı. Stoğu değiştiren
/// her yol (sipariş, iptal, iade, değişim, elle düzeltme, mal kabulü, sayım,
/// toplu yükleme) aynı yardımcıdan geçiyor ve satırı stok değişikliğiyle
/// **aynı işlemde** yazıyor: biri olup öteki olmamıyor.
///
/// Ürün adı, beden ve renk kopyalanıyor: beden silinse de geçmiş okunabilsin.
model StockMovement {
  id        String          @id @default(cuid())
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String
  urunAd    String
  beden     String
  renk      String

  /// Artı giriş, eksi çıkış; `sonra` hareketten sonraki stok.
  degisim Int
  sonra   Int
  /// siparis · iptal · iade · degisim-geri · degisim · duzeltme · mal-kabul ·
  /// sayim · toplu · yeni · silindi
  sebep     String
  siparisNo String?
  /// Panelden yapıldıysa kim; müşteri ya da zamanlı iş yaptıysa boş.
  adminId   String?
  yapan     String  @default("")
  not       String  @default("")

  olusturuldu DateTime @default(now())

  @@index([variantId, olusturuldu])
  @@index([productId, olusturuldu])
  @@index([olusturuldu])
}

/// Stok sayımı (K-107): raftaki gerçek adet sistemle karşılaştırılıyor.
///
/// Açılınca kapsamdaki her beden-renk için bir satır yazılıyor. Satır
/// sayıldığı anda "rafta olması gereken" (stok + kargolanmamış siparişte
/// ayrılan) da o satıra yazılıyor. Fark buna göre; sayım sürerken gelen
/// satış iki kez düşülmüyor. Bitirilince farklar stoğa uygulanıyor ve "sayım
/// farkı" hareketi yazılıyor (K-103).
model StockCount {
  id          String    @id @default(cuid())
  ad          String
  /// Kategori adresi; boşsa bütün ürünler.
  kapsam      String    @default("")
  /// acik · tamam · iptal
  durum       String    @default("acik")
  adminId     String?
  yapan       String    @default("")
  olusturuldu DateTime  @default(now())
  bitti       DateTime?

  satirlar StockCountLine[]

  @@index([durum, olusturuldu])
}

model StockCountLine {
  id         String          @id @default(cuid())
  countId    String
  count      StockCount      @relation(fields: [countId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId  String
  urunAd     String
  beden      String
  renk       String
  sku        String
  fiyatKurus Int

  /// Rafta sayılan; boşsa henüz sayılmadı.
  sayilan   Int?
  /// Sayıldığı an sistemdeki stok ve kargolanmamış siparişte ayrılan adet.
  sistem    Int?
  ayrilan   Int?
  sayildi   DateTime?
  /// Bitirilirken stoğa uygulanan fark (sayılan − sistem − ayrılan).
  uygulanan Int?

  @@index([countId])
  @@index([variantId])
}

/// "Stoka girince haber ver" isteği.
///
/// Tükenmiş bir beden-renk için müşterinin bıraktığı adres. Ticari ileti
/// değil, müşterinin kendi isteği üzerine gönderilen tek seferlik bir
/// bildirim; o yüzden pazarlama izni aranmıyor. Gönderildiği an kayıt
/// siliniyor: adresin tutulma sebebi ortadan kalkmış oluyor (K-28).
model StockAlert {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  eposta      String
  olusturuldu DateTime @default(now())

  @@unique([variantId, eposta])
  @@index([variantId])
  @@index([olusturuldu])
}

/// Müşterinin iptal, iade ya da değişim talebi.
///
/// Mesafeli satışta cayma hakkı yasal: teslimden itibaren 14 gün, gerekçe
/// göstermeden. Talep bu kayıtla açılıyor ve panelden cevaplanıyor — telefon
/// ya da e-posta trafiği yerine izi kalan tek bir akış (K-33).
///
/// Talep siparişi kendiliğinden değiştirmiyor. Tek istisna: onaylanan iptal,
/// siparişi iptal edip stoğu geri veriyor. İade ve değişimde ürünün geri
/// gelmesi gerekiyor, o yüzden kararı mağaza sahibi veriyor.
model OrderRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// iptal · iade · degisim
  tur      String
  /// Sebep kodu (bkz. ui/talep-bicim.ts). Yasal olarak gerekçe zorunlu değil;
  /// "belirtmek istemiyorum" da bir seçenek.
  sebep    String
  aciklama String @default("")

  /// yeni · onaylandi · reddedildi · tamamlandi
  durum String @default("yeni")
  /// Mağaza sahibinin yanıtı; müşteriye olduğu gibi gösteriliyor.
  cevap String @default("")

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  satirlar OrderRequestItem[]
  iadeler  Refund[]

  @@index([durum, olusturuldu])
  @@index([orderId])
}

/// Talebin kapsadığı sipariş satırı ve adedi.
///
/// Üç ürünün birini iade etmek bebek kıyafetinde sık: beden biri tutmaz,
/// ötekiler tutar. Talebin tamamı ya da hiçbiri olması müşteriyi telefona
/// mecbur bırakırdı.
model OrderRequestItem {
  id        String       @id @default(cuid())
  requestId String
  request   OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  adet Int

  @@unique([requestId, orderItemId])
  @@index([requestId])
}

/// Ürün değerlendirmesi.
///
/// **Yalnızca gerçekten satın almış kişi yazabiliyor.** Kayıt bir sipariş
/// satırına bağlı (`orderItemId` tekil): hem alışverişin kanıtı hem de aynı
/// satır için ikinci yorumun önüne geçiyor. Aynı ürünü iki kez alan iki kez
/// yazabiliyor, bu doğru.
///
/// **Yorum kendiliğinden yayımlanıyor, onay beklemiyor.** Olumsuz yorumu
/// süzmek e-ticaret mevzuatına aykırı: satıcı olumlu olumsuz ayrımı yapmadan
/// yayımlamak zorunda. Gizleme yalnızca içerik kuralı için — hakaret, kişisel
/// veri, alakasız metin — ve sebebi kaydediliyor ki "beğenmedim" diye
/// gizlenmediği belli olsun (K-34).
model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Hangi sipariş satırı için yazıldı. Alışverişin kanıtı.
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// Ekranda görünen ad. Tam ad değil: "Ayşe Y." gibi kısaltılıyor.
  adSoyad String
  /// 1-5 arası.
  puan    Int
  yorum   String

  /// yayinda · gizli
  durum         String @default("yayinda")
  /// Gizlenme sebebi. Olumsuz olması sebep değildir.
  gizlemeSebebi String @default("")

  /// Satıcı yanıtı; yorumun altında görünüyor.
  yanit String @default("")

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([productId, durum])
  @@index([durum, olusturuldu])
}

/// Giriş denemesi sayacı.
///
/// scrypt her denemeyi yavaşlatıyor ama sınır koymuyor: bir hesaba saatlerce
/// şifre denenebilirdi. Sayaç iki anahtarla tutuluyor (K-38):
///
/// - `eposta:<özet>` — hedeflenen hesabı korur. Anahtar e-postanın özeti,
///   hesabın kimliği değil: hesap var da olsa yok da olsa aynı davranıyor,
///   yani kilit mesajı hangi adreslerin kayıtlı olduğunu ele vermiyor.
/// - `ip:<özet>` — tek bir yerden çok sayıda hesaba şifre denemesini durdurur.
///
/// IP'nin kendisi değil özeti saklanıyor ve kayıtlar günlük temizlikte
/// siliniyor: sayaç için gereken şey adresin kendisi değil, aynı yerden
/// gelip gelmediği.
model LoginThrottle {
  /// "eposta:<sha256>" ya da "ip:<sha256>"
  id          String    @id
  sayac       Int       @default(0)
  ilkDeneme   DateTime  @default(now())
  kilitBitis  DateTime?
  guncellendi DateTime  @updatedAt

  @@index([guncellendi])
}

/// Panel kullanıcısı.
///
/// Mağaza müşterisinden (Customer) tamamen ayrı: farklı tablo, farklı çerez,
/// farklı oturum. Müşteri oturumu hiçbir koşulda panele geçiş vermiyor
/// (K-45).
///
/// Rol yok: her panel kullanıcısı her şeyi yapabiliyor. Eskiden "sahip" ve
/// "yönetici" vardı; sonradan açılan hesaplar yönetici oluyor ve menüde
/// Kullanıcılar'ı göremiyordu, bu da hata sanılıyordu (K-79).
model AdminUser {
  id          String    @id @default(cuid())
  eposta      String    @unique
  adSoyad     String
  /// scrypt özeti; müşteri şifreleriyle aynı biçim (server/uyelik.ts).
  sifreOzeti  String
  /// Kapatılan kullanıcı giremiyor ama kaydı duruyor: kimin ne zaman ne
  /// yaptığı sorusu silinmiş bir satırla cevaplanamıyor.
  aktif       Boolean   @default(true)
  olusturuldu DateTime  @default(now())
  sonGiris    DateTime?
  /// Davet bağlantısıyla şifresini belirlediği an. Boşsa hesap "davet
  /// bekliyor": e-postanın o kişiye ait olduğu kanıtlanmadı, giriş yapamıyor
  /// (K-87).
  epostaDogrulandi DateTime?
  /// Sabah özeti e-postası (K-101): dünün satışı ve bugünün işleri. Her
  /// kullanıcı kendi Hesabım ekranından kapatabiliyor. Son gönderim, aynı
  /// gün ikinci kez gönderilmesin diye tutuluyor.
  sabahOzeti           Boolean   @default(true)
  sabahOzetiGonderildi DateTime?

  oturumlar AdminSession[]
  jetonlar  AdminToken[]

  @@index([aktif])
}

/// Panel şifre sıfırlama jetonu.
///
/// Müşteri tarafındaki `CustomerToken` ile aynı mantık: jetonun kendisi değil
/// SHA-256 özeti saklanıyor, bir saat yaşıyor ve bir kez kullanılabiliyor.
/// Yeni bağlantı istenince eskisi siliniyor — eski bir e-postadaki bağlantı
/// aylarca açık kalmasın (K-47).
model AdminToken {
  id          String    @id
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  biter       DateTime
  kullanildi  DateTime?
  olusturuldu DateTime  @default(now())

  @@index([adminId])
  @@index([biter])
}

/// Panel oturumu. Çerezdeki jetonun kendisi değil SHA-256 özeti saklanıyor;
/// veritabanını görebilen biri kimsenin oturumunu ele geçiremesin.
model AdminSession {
  id          String    @id
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  olusturuldu DateTime  @default(now())
  sonGorulme  DateTime  @default(now())
  biter       DateTime

  @@index([adminId])
  @@index([biter])
}

/// Müşterinin favorileri (K-94). Hesap silinince gidiyor; ürün silinince de
/// o satır gidiyor, favori listesinde var olmayan bir ürün kalmıyor.
model Favorite {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  olusturuldu DateTime @default(now())

  /// Son bakışta görülen fiyat ve stokta olan bedenler (K-100). Günlük
  /// tarama bunlarla karşılaştırıp indirim ve yeniden stoğa giren bedeni
  /// buluyor. Fiyat boşsa kayda hiç bakılmamış: ilk tarama yalnızca yazıyor.
  bakilanFiyatKurus Int?
  stoktakiBedenler  String[] @default([])

  @@unique([customerId, productId])
  @@index([customerId])
}
