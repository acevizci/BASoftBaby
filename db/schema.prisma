// BASoftBaby veri modeli — katalog ve sipariş bölümü.
//
// Bağlantı adresi burada durmaz; Vercel'de DATABASE_URL olarak tanımlı.
//
// Para her yerde tam sayı kuruş (bkz. docs/02-mimari.md, 01. karar).

generator client {
  provider = "prisma-client"
  output   = "../db/uretilen"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  ad        String
  aciklama  String?
  sira      Int        @default(0)
  aktif     Boolean    @default(true)
  products  Product[]
  campaigns Campaign[]

  @@index([aktif, sira])
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  ad         String
  ozet       String
  aciklama   String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  fiyatKurus     Int
  eskiFiyatKurus Int?

  // Bebek tekstilinde yasal zorunluluk (bkz. docs/01-kurulus-plani.md § 3)
  kumasIcerigi   String
  yikamaTalimati String
  ureticiBilgisi String?

  puan        Decimal? @db.Decimal(2, 1)
  yorumSayisi Int      @default(0)

  /// Ürün sayfasındaki madde madde özellikler
  ozellikler String[]

  /// Kart üzerindeki rozet: "Çok satan", "%20", "Son 3 adet"
  rozetTon  String?
  rozetYazi String?

  /// Gerçek fotoğraflar çekilene kadar kullanılan çizim ve renk paleti.
  /// Fotoğraflar geldiğinde ProductImage devreye girip bunlar düşecek.
  gorsel String @default("zibin")
  palet  String @default("mint")

  aktif       Boolean  @default(true)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  variants  ProductVariant[]
  images    ProductImage[]
  campaigns Campaign[]

  @@index([categoryId, aktif])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  beden      String
  renk       String
  /// Stok kodu — kargo ve sayımda kullanılır
  sku        String @unique
  stok       Int    @default(0)
  /// Varyant bazlı fiyat farkı; boşsa ürünün fiyatı geçerli
  fiyatKurus Int?

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, beden, renk])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Büyük görselin adresi (yayında Vercel Blob URL'i, yerelde /yuklenen/...)
  yol String
  /// Kartlarda kullanılan küçük kopya
  kucukYol String @default("")

  /// Büyük görselin ölçüleri: img etiketine yazılıyor, sayfa zıplamasın diye
  genislik Int @default(0)
  yukseklik Int @default(0)
  boyutBayt Int @default(0)

  altMetin String
  sira     Int    @default(0)

  olusturuldu DateTime @default(now())

  @@index([productId, sira])
}

/// Duyuru şeridindeki tek bir mesaj. Tarihi geçen mesaj sorgudan düşer.
model Announcement {
  id          String    @id @default(cuid())
  metin       String
  link        String?
  sira        Int       @default(0)
  aktif       Boolean   @default(true)
  baslangic   DateTime?
  bitis       DateTime?
  olusturuldu DateTime  @default(now())

  @@index([aktif, sira])
}

/// Sitenin tek satırlık ayar kaydı. id her zaman "tek".
model StoreSetting {
  id               String  @id @default("tek")
  seritAcik        Boolean @default(true)
  seritHiz         String  @default("orta")
  seritRenk        String  @default("nane")
  seritDurdurHover Boolean @default(true)
  seritMobilde     Boolean @default(true)
  tohumAtildi      Boolean @default(false)

  /// Sipariş numarası sayacı. Sipariş oluşturulurken aynı işlem içinde artar.
  sonSiparisNo Int @default(0)

  kargoKurus       Int @default(4990)
  /// Bu tutarın üstünde kargo bedava. Sıfır verilirse kargo hep ücretli.
  bedavaKargoEsigi Int @default(75000)

  /// Havale/EFT yapacak müşteriye gösterilen banka bilgisi. Boşsa bu ödeme
  /// yöntemi müşteriye hiç sunulmaz.
  havaleBilgisi String @default("")

  /// Ana sayfadaki banner kaç saniyede bir değişsin
  bannerSaniye Int @default(6)

  /// Örnek bannerlar bir kez yazıldı mı. Silinen banner yayında geri gelmesin diye.
  bannerTohumu Boolean @default(false)

  /// Satıcı künyesi. Mesafeli satışta müşteriye gösterilmesi zorunlu; alt
  /// bilgide ve yasal metinlerin altında bu alanlar basılıyor. Boş olanlar
  /// hiç gösterilmiyor, yarım künye yerine eksik satır görünmesin diye.
  unvan         String @default("")
  vergiDairesi  String @default("")
  vergiNo       String @default("")
  mersisNo      String @default("")
  /// ETBİS kayıt numarası — e-ticaret sitelerinde sitede görünmesi zorunlu.
  etbisNo       String @default("")
  sirketAdresi  String @default("")
  destekTelefon String @default("")
  destekEposta  String @default("")

  /// Faturada kullanılan KDV oranı (yüzde). Bebek tekstilinde 10; ürün
  /// grubuna göre değişirse panelden güncelleniyor.
  kdvOrani Int @default(10)
  /// Fatura numarası sayacı. Fatura oluşturulurken aynı işlem içinde artıyor.
  sonFaturaNo Int @default(0)
  /// Panelde kargo alanına önceden seçili gelen taşıyıcı.
  varsayilanTasiyici String @default("yurtici")
}

/// Ziyaretçinin sepeti. Tarayıcıdaki `sepet` çerezi bu kaydın id'sini tutar;
/// çerez httpOnly olduğu için içeriği yalnızca sunucu değiştirebilir.
/// Sepette fiyat tutulmaz: fiyat her görüntülemede üründen okunur, böylece
/// panelden yapılan fiyat değişikliği sepete de yansır.
model Cart {
  id          String     @id @default(cuid())
  olusturuldu DateTime   @default(now())
  guncellendi DateTime   @updatedAt
  satirlar    CartItem[]

  @@index([guncellendi])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adet      Int            @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

/// Sipariş. Sipariş satırları ürün silinse bile bozulmasın diye ürün adını,
/// bedenini ve o günkü fiyatını kendi içinde kopya tutar.
model Order {
  id     String @id @default(cuid())
  /// Müşteriye gösterilen numara: BA-2026-0001
  numara String @unique

  /// bekliyor · hazirlaniyor · kargoda · teslim · iptal
  durum        String @default("bekliyor")
  /// havale · kart (iyzico)
  odemeYontemi String @default("havale")
  /// bekliyor · odendi · iade
  odemeDurumu  String @default("bekliyor")

  adSoyad   String
  eposta    String
  telefon   String
  adres     String
  ilce      String
  il        String
  postaKodu String
  not       String @default("")

  araToplamKurus Int
  /// Uygulanan kampanyanın indirimi. İndirimler üst üste binmez (K-02).
  indirimKurus   Int     @default(0)
  /// Müşteriye gösterilen kampanya adı; sonradan kampanya silinse de kalır.
  kampanyaAdi    String?
  kargoKurus     Int
  toplamKurus    Int

  /// Kargo firması takip numarası; 05. adımda kargo entegrasyonu dolduracak.
  kargoTakipNo String?

  /// Müşterinin ön bilgilendirme formu ile mesafeli satış sözleşmesini
  /// onayladığı an. Onay kutusu işaretlenmeden sipariş oluşmuyor; kaydı
  /// burada duruyor ki sonradan "onaylamadım" denemesin.
  sozlesmeOnayi DateTime?

  /// Sipariş üye olarak verildiyse hesabı. Üyeliksiz siparişlerde boş kalır;
  /// hesap silinse bile sipariş kaydı ayakta kalsın diye ilişki SetNull.
  /// Eski siparişler e-postası tuttuğu için kendiliğinden bağlanmaz (K-14).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  olusturuldu DateTime    @default(now())
  guncellendi DateTime    @updatedAt
  satirlar    OrderItem[]
  odemeler    Payment[]
  gonderiler  Shipment[]
  fatura      Invoice?

  @@index([durum, olusturuldu])
  @@index([eposta])
  @@index([customerId, olusturuldu])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Ürün sonradan silinirse boşa düşer, sipariş kaydı ayakta kalır.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  urunAd     String
  slug       String
  beden      String
  renk       String
  adet       Int
  /// Sipariş anındaki birim fiyat. Sonradan fiyat değişse bile bu değişmez.
  fiyatKurus Int

  @@index([orderId])
}

/// Kampanya ve kupon.
///
/// İndirimler ÜST ÜSTE BİNMEZ: bir sepete birden çok kampanya uyuyorsa
/// yalnızca en çok indiren uygulanır (bkz. docs/04-kararlar.md, K-02).
/// Kupon kodu olanlar müşteri kodu yazana kadar uygulanmaz; kodu boş olanlar
/// koşulları tuttuğu anda kendiliğinden devreye girer.
model Campaign {
  id String @id @default(cuid())
  ad String

  /// yuzde · tutar
  tip   String @default("yuzde")
  /// yuzde ise 20 (= %20), tutar ise kuruş
  deger Int

  /// tumu · kategori · urun
  kapsam     String    @default("tumu")
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Boşsa kampanya kendiliğinden uygulanır; doluysa müşteri bu kodu yazmalı.
  kuponKodu String? @unique

  /// Sepet ara toplamı bu tutarın altındaysa kampanya uygulanmaz.
  enAzSepetKurus Int @default(0)

  aktif     Boolean   @default(true)
  baslangic DateTime?
  bitis     DateTime?

  /// Kaç siparişte uygulandığı; panelde raporlama için.
  kullanim    Int      @default(0)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([aktif, baslangic, bitis])
  @@index([categoryId])
  @@index([productId])
}

/// Ana sayfanın üstündeki dönen banner. Birden çok kayıt varsa sırayla
/// kendiliğinden geçer; tek kayıt varsa sabit durur.
model HeroBanner {
  id      String @id @default(cuid())
  baslik  String
  altYazi String @default("")

  dugmeYazi String @default("")
  dugmeLink String @default("")

  /// Arka plan paleti ve yanında duran çizim
  palet  String @default("sari")
  gorsel String @default("amblem")

  sira      Int       @default(0)
  aktif     Boolean   @default(true)
  baslangic DateTime?
  bitis     DateTime?

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([aktif, sira])
}

/// Müşteri hesabı.
///
/// Şifrenin kendisi hiçbir yerde durmaz; `sifreOzeti` scrypt ile üretilmiş
/// özeti tutar (bkz. server/uyelik.ts). E-posta henüz doğrulanmıyor: doğrulama
/// için e-posta servisi gerekiyor, o 04. adımda gelecek (K-14).
model Customer {
  id          String   @id @default(cuid())
  eposta      String   @unique
  adSoyad     String
  telefon     String   @default("")
  sifreOzeti  String
  /// E-postanın sahibi olduğu kanıtlandığı an. Doğrulanana kadar o adresle
  /// üyeliksiz verilmiş siparişler hesaba bağlanmıyor (K-14).
  epostaDogrulandi DateTime?
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  oturumlar  CustomerSession[]
  adresler   Address[]
  siparisler Order[]
  jetonlar   CustomerToken[]
}

/// Tek kullanımlık e-posta jetonu: şifre sıfırlama ve e-posta doğrulama.
///
/// Oturumda olduğu gibi jetonun kendisi değil SHA-256 özeti saklanıyor:
/// veritabanını görebilen biri kimsenin şifresini sıfırlayamasın. Kullanılan
/// jeton bir daha çalışmıyor, süresi geçen de.
model CustomerToken {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// sifirlama · dogrulama
  tur         String
  biter       DateTime
  kullanildi  DateTime?
  olusturuldu DateTime @default(now())

  @@index([customerId, tur])
  @@index([biter])
}

/// Açık oturum.
///
/// Çerezdeki jetonun kendisi değil, SHA-256 özeti saklanır: veritabanını
/// görebilen biri oturumları ele geçiremesin. Süresi geçen kayıtlar okuma
/// sırasında siliniyor.
model CustomerSession {
  id          String   @id
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  olusturuldu DateTime @default(now())
  sonGorulme  DateTime @default(now())
  biter       DateTime

  @@index([customerId])
  @@index([biter])
}

/// Adres defteri. Sipariş bu kaydı işaret etmez, içeriğini kopyalar: adres
/// sonradan değişse bile eski siparişin teslimat bilgisi olduğu gibi kalır.
model Address {
  id         String  @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  baslik     String  @default("Adresim")
  adSoyad    String
  telefon    String
  adres      String
  ilce       String
  il         String
  postaKodu  String  @default("")
  varsayilan Boolean @default(false)

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([customerId, varsayilan])
}

/// Yasal metin sayfası: mesafeli satış sözleşmesi, ön bilgilendirme formu,
/// KVKK aydınlatma metni, çerez politikası.
///
/// İçerik panelden düzenleniyor, koda gömülü değil: avukattan gelen metin
/// yayın beklemeden yapıştırılabilsin. `taslakMi` işaretliyken sayfanın
/// tepesinde metnin taslak olduğu yazıyor — müşteri onaylanmış sanmasın.
model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  baslik      String
  ozet        String   @default("")
  /// Düz metin. Boş satır paragrafı, "## " ile başlayan satır başlığı,
  /// "- " ile başlayan satır madde olur (bkz. ui/yasal-metin.tsx).
  icerik      String
  taslakMi    Boolean  @default(true)
  sira        Int      @default(0)
  guncellendi DateTime @updatedAt

  @@index([sira])
}

/// Kartla ödeme girişimi.
///
/// Bir siparişin birden çok girişimi olabilir: kart reddedilir, müşteri tekrar
/// dener. Her girişim ayrı satır; siparişin ödendi sayılması için birinin
/// başarılı olması yeterli.
///
/// Kart numarası, CVC ve 3D Secure şifresi hiçbir aşamada bize gelmez: müşteri
/// bunları iyzico'nun kendi ekranına girer (K-07, K-17). Burada yalnızca
/// iyzico'nun verdiği kimlikler ve tutar durur.
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  saglayici String @default("iyzico")
  /// Ödeme formunun jetonu. Dönüş çağrısı bunu getiriyor, kaydı bununla
  /// buluyoruz; tekil olduğu için aynı dönüş iki kez işlenmiyor (K-06).
  jeton        String  @unique
  /// iyzico ödeme kimliği — iade ve sorgulama için gerekiyor.
  saglayiciRef String?

  /// baslatildi · basarili · basarisiz
  durum      String @default("baslatildi")
  tutarKurus Int
  taksit     Int    @default(1)
  /// Başarısızsa iyzico'nun verdiği sebep; müşteriye gösterilen kısa hâli.
  hata       String?
  /// Sorun çıkarsa bakılabilsin diye iyzico'nun ham cevabı (JSON).
  hamYanit   String?

  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([orderId])
  @@index([durum, olusturuldu])
}

/// Kargo gönderisi.
///
/// Taşıyıcı toplayıcısı (Geliver/Navlungo) bağlanana kadar panelden elle
/// giriliyor: mağaza sahibi anlaşmalı kargodan aldığı takip numarasını
/// yazıyor, müşteriye bildirim kendiliğinden gidiyor. Toplayıcı gelince
/// `saglayici`, `saglayiciRef` ve `etiketAdresi` dolacak, geri kalan akış
/// aynı kalacak (K-19).
model Shipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// yurtici · aras · mng · ptt · surat · diger
  tasiyici String
  takipNo  String
  /// Etikette basılan barkod. Takip numarası varsa o, yoksa sipariş numarası.
  barkod   String

  /// Toplayıcı bağlanınca dolacak alanlar.
  saglayici    String?
  saglayiciRef String?
  etiketAdresi String?

  /// hazirlandi · verildi · yolda · teslim · iade
  durum       String   @default("hazirlandi")
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([orderId])
  @@index([takipNo])
}

/// e-Arşiv fatura kaydı.
///
/// Fatura sağlayıcısı (Paraşüt, Bizim Hesap) bağlanana kadar fatura burada
/// oluşturulup panelden yazdırılıyor; kesilen resmî faturanın numarası ve
/// bağlantısı sonradan buraya yazılabiliyor. Tutarlar sipariş anındaki
/// hâlinden kopyalanıyor, sonradan değişen KDV oranı eski faturayı
/// bozmuyor (K-20).
model Invoice {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// BA-F-2026-0001
  numara String   @unique
  tarih  DateTime @default(now())

  /// Yüzde olarak KDV oranı; matrah ve KDV kuruş.
  kdvOrani    Int
  matrahKurus Int
  kdvKurus    Int
  toplamKurus Int

  /// Resmî fatura dışarıda kesildiyse numarası ve belgesi.
  saglayici    String?
  saglayiciRef String?
  pdfAdresi    String?

  /// taslak · kesildi · iptal
  durum       String   @default("taslak")
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt
}
