// BASoftBaby veri modeli — katalog bölümü.
//
// Bağlantı adresi burada durmaz; Vercel'de DATABASE_URL olarak tanımlı.
//
// Para her yerde tam sayı kuruş (bkz. docs/02-mimari.md, 01. karar).

generator client {
  provider = "prisma-client"
  output   = "../db/uretilen"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  ad       String
  aciklama String?
  sira     Int        @default(0)
  aktif    Boolean    @default(true)
  products Product[]

  @@index([aktif, sira])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  ad            String
  ozet          String
  aciklama      String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  fiyatKurus    Int
  eskiFiyatKurus Int?

  // Bebek tekstilinde yasal zorunluluk (bkz. docs/01-kurulus-plani.md § 3)
  kumasIcerigi  String
  yikamaTalimati String
  ureticiBilgisi String?

  puan          Decimal? @db.Decimal(2, 1)
  yorumSayisi   Int      @default(0)

  /// Ürün sayfasındaki madde madde özellikler
  ozellikler    String[]

  /// Kart üzerindeki rozet: "Çok satan", "%20", "Son 3 adet"
  rozetTon      String?
  rozetYazi     String?

  /// Gerçek fotoğraflar çekilene kadar kullanılan çizim ve renk paleti.
  /// Fotoğraflar geldiğinde ProductImage devreye girip bunlar düşecek.
  gorsel        String   @default("zibin")
  palet         String   @default("mint")

  aktif         Boolean  @default(true)
  olusturuldu   DateTime @default(now())
  guncellendi   DateTime @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]

  @@index([categoryId, aktif])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  beden     String
  renk      String
  /// Stok kodu — kargo ve sayımda kullanılır
  sku       String  @unique
  stok      Int     @default(0)
  /// Varyant bazlı fiyat farkı; boşsa ürünün fiyatı geçerli
  fiyatKurus Int?

  @@unique([productId, beden, renk])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Cloudflare R2'deki dosya yolu. Boyutlar bundan türetilir
  yol       String
  altMetin  String
  sira      Int     @default(0)

  @@index([productId, sira])
}

/// Duyuru şeridindeki tek bir mesaj. Tarihi geçen mesaj sorgudan düşer.
model Announcement {
  id         String    @id @default(cuid())
  metin      String
  link       String?
  sira       Int       @default(0)
  aktif      Boolean   @default(true)
  baslangic  DateTime?
  bitis      DateTime?
  olusturuldu DateTime @default(now())

  @@index([aktif, sira])
}

/// Sitenin tek satırlık ayar kaydı. id her zaman "tek".
model StoreSetting {
  id               String  @id @default("tek")
  seritAcik        Boolean @default(true)
  seritHiz         String  @default("orta")
  seritRenk        String  @default("nane")
  seritDurdurHover Boolean @default(true)
  seritMobilde     Boolean @default(true)
  tohumAtildi      Boolean @default(false)
}
